PORT=3001
PUBLIC_URL=https://roside.example.edu
DB_HOST=localhost
DB_USER=ros2ide
DB_PASS=replace-me
DB_NAME=ros2ide
ENC_KEY=replace-with-at-least-32-random-characters
AUTH_TOKEN_SECRET=replace-with-a-long-random-login-token-secret
ADMIN_PASSWORD=replace-with-at-least-12-characters
CORS_ORIGINS=https://roside.example.edu
ALLOW_REGISTRATION=false
SHOW_SSO_DEBUG_KEY=false
ALLOW_UNSANDBOXED_SIM=false
JSON_LIMIT=10mb
TRUST_PROXY=true

# --- Stripe Billing (เว้นว่างไว้จนกว่าจะสร้างบัญชี/สินค้าใน Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public URL ของ instance ที่รับ webhook/แสดงหน้า Applications เช่น https://example.ts.net:8443
BILLING_PUBLIC_URL=
# Price IDs เป็น optional; หากเว้นว่าง server จะสร้าง price_data ตามราคาที่กำหนดใน server.js
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PRO_LIFETIME=
